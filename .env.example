# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL database variables (auto-injected by platform)
SQL_HOST="127.0.0.1"
SQL_USER="my_app_user"
SQL_PASSWORD="my_app_password"
SQL_DB_NAME="my_app_db"
SQL_ADMIN_USER="ai_studio_admin"
SQL_ADMIN_PASSWORD="my_admin_password"

# Stripe / Payment Provider Credentials (for production webhook verification)
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# Map API Key (Optional for map tiles)
MAP_API_KEY="AIzaSy_placeholder"
